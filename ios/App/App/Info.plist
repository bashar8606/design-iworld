	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.yourname.solaroasis</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>solaroasis</string>
			</array>
		</dict>
	</array>
