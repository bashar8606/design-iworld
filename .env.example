# Copy to .env.local and fill in. Values are baked into the build.
# PostHog project API key (Project settings → Project API key) and host.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Sentry DSN for crash and error reporting (Phase 7).
VITE_SENTRY_DSN=
# Shown in analytics and the settings sheet.
VITE_APP_VERSION=0.1.0
# RevenueCat public iOS SDK key (Phase 6). Without it, purchases use the web stub.
VITE_REVENUECAT_IOS_KEY=
# 1 = Google test ads even in release builds (TestFlight checks).
VITE_ADS_TEST=
